{%- capture wa_number -%}{%- render 'whatsapp-number', wa_override: settings.whatsapp_number, wa_store: shop.phone -%}{%- endcapture -%}
<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_accent }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {%- else -%}
      <link rel="icon" type="image/png" href="{{ 'zarnoor-favicon.png' | asset_url }}">
      <link rel="apple-touch-icon" href="{{ 'zarnoor-favicon.png' | asset_url }}">
    {%- endif -%}
    <link rel="canonical" href="{{ canonical_url }}">

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    <meta property="og:site_name" content="{{ shop.name }}">
    <meta property="og:title" content="{{ page_title | escape }}">
    <meta property="og:type" content="{% if template contains 'product' %}product{% else %}website{% endif %}">
    <meta property="og:url" content="{{ canonical_url }}">
    {% if page_description %}<meta property="og:description" content="{{ page_description | escape }}">{% endif %}
    {% if template contains 'product' and product.featured_image %}
      <meta property="og:image" content="https:{{ product.featured_image | image_url: width: 1200 }}">
    {% elsif settings.logo %}
      <meta property="og:image" content="https:{{ settings.logo | image_url: width: 600 }}">
    {% endif %}
    <meta name="twitter:card" content="summary_large_image">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Lato:wght@300;400;500;600&display=swap" rel="stylesheet">

    {{ content_for_header }}

    <style>
      :root {
        --paper: {{ settings.color_background | default: '#FFFFFF' }};
        --soft: {{ settings.color_soft | default: '#FAF9F6' }};
        --ink: {{ settings.color_text | default: '#1D1B19' }};
        --accent: {{ settings.color_accent | default: '#4A1620' }};
        --logo-width: {{ settings.logo_width | default: 116 }}px;
      }
    </style>
    {{ 'theme.css' | asset_url | stylesheet_tag }}

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": {{ shop.name | json }},
        "url": {{ shop.url | json }}
        {% if settings.logo %},"logo": "https:{{ settings.logo | image_url: width: 600 }}"{% endif %}
      }
    </script>

    <script>document.documentElement.classList.remove('no-js');</script>
  </head>

  <body class="template-{{ template.name | handle }}{% if settings.logo_footer_white %} footer-logo-white{% endif %}">
    <a class="skip-link" href="#MainContent">Skip to content</a>

    {% render 'preloader' %}

    <div class="site-wrapper">
      {% section 'announcement-bar' %}
      {% section 'header' %}

      <main id="MainContent" class="main-content" role="main" tabindex="-1">
        {{ content_for_layout }}
      </main>

      {% section 'footer' %}

      {% render 'mobile-drawer' %}
      {% render 'search-modal' %}
      {% render 'quick-view-modal' %}
      {% render 'wishlist-drawer' %}
      {% render 'cart-drawer' %}
      {% render 'mobile-tabbar' %}
    </div>

    <script>
      (function () {
        var preloader = document.getElementById('site-preloader');
        if (!preloader) return;
        var done = false;
        function hide() {
          if (done) return;
          done = true;
          preloader.classList.add('is-hidden');
          setTimeout(function () { if (preloader.parentNode) preloader.parentNode.removeChild(preloader); }, 600);
        }
        if (document.readyState === 'complete') {
          setTimeout(hide, 250);
        } else {
          window.addEventListener('load', function () { setTimeout(hide, 250); });
        }
        setTimeout(hide, 3500);
      })();
    </script>
    <script>
      window.zarnoorSettings = {
        moneyFormat: {{ shop.money_format | json }},
        freeShipping: {{ settings.free_shipping_threshold | default: 0 | json }},
        whatsapp: {{ wa_number | json }},
        cartUrl: {{ routes.cart_url | json }},
        searchUrl: {{ routes.search_url | json }}
      };
    </script>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </body>
</html>
