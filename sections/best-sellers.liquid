{%- assign best_seller_collection = section.settings.collection | default: collections['all'] -%}
{%- assign best_seller_tag = section.settings.tag | default: 'best-seller' | downcase | strip -%}
{%- assign product_limit = section.settings.products_to_show | default: 4 -%}

<section id="best-sellers" class="section-products best-sellers-carousel" data-best-sellers-carousel>
  <div class="section-header">
    <div class="section-header-title-block">
      {%- if section.settings.eyebrow != blank -%}
        <span class="section-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2 class="section-title">{{ section.settings.title | default: 'Best sellers' }}</h2>
    </div>
    {%- if section.settings.show_view_all -%}
      <a class="editorial-link" href="{{ best_seller_collection.url | default: '/collections/all' }}">View all</a>
    {%- endif -%}
  </div>

  {%- assign rendered_count = 0 -%}
  <div class="best-sellers-track" data-best-sellers-track aria-label="Best selling products">
    {%- paginate best_seller_collection.products by 250 -%}
      {%- for product in best_seller_collection.products -%}
        {%- assign product_tag_match = false -%}
        {%- for product_tag in product.tags -%}
          {%- assign normalized_product_tag = product_tag | downcase | strip -%}
          {%- if normalized_product_tag == best_seller_tag -%}
            {%- assign product_tag_match = true -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if product_tag_match -%}
          {%- assign product_card_index = rendered_count | plus: 1 -%}
          <div class="best-sellers-slide">{% render 'product-card', product: product, index: product_card_index %}</div>
          {%- assign rendered_count = rendered_count | plus: 1 -%}
          {%- if rendered_count >= product_limit -%}{%- break -%}{%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endpaginate -%}
  </div>

  {%- if rendered_count > 1 -%}
    <div class="best-sellers-controls" aria-label="Best sellers carousel controls">
      <button type="button" data-best-sellers-prev aria-label="Previous products">←</button>
      <button type="button" data-best-sellers-next aria-label="Next products">→</button>
    </div>
  {%- endif -%}

  {%- if rendered_count == 0 -%}
    <div class="empty-state">
      <h2>{{ section.settings.empty_heading | default: 'Best sellers are coming soon' }}</h2>
      <p>{{ section.settings.empty_text | default: 'Add the best-seller tag to products to feature them here.' }}</p>
    </div>
  {%- endif -%}
</section>

<style>
  #best-sellers { position:relative; padding:clamp(28px,4vw,54px) clamp(18px,4vw,54px); background:linear-gradient(135deg,#fbf6f1 0%,#f5ece4 100%); overflow:hidden; }
  #best-sellers .section-header { margin-bottom:24px; }
  #best-sellers .best-sellers-track { display:flex; gap:14px; overflow-x:auto; scroll-snap-type:x mandatory; scrollbar-width:none; scroll-behavior:smooth; padding:2px 2px 10px; }
  #best-sellers .best-sellers-track::-webkit-scrollbar { display:none; }
  #best-sellers .best-sellers-slide { flex:0 0 calc(50% - 7px); min-width:0; scroll-snap-align:start; }
  #best-sellers .product-card { width:100%; border-radius:10px; overflow:hidden; background:#fff; box-shadow:0 8px 24px rgba(71,39,32,.08); transition:transform .25s ease,box-shadow .25s ease; }
  #best-sellers .product-card:hover { transform:translateY(-4px); box-shadow:0 14px 30px rgba(71,39,32,.14); }
  #best-sellers .best-sellers-controls { position:absolute; inset:50% 12px auto; z-index:3; display:flex; justify-content:space-between; pointer-events:none; transform:translateY(-50%); }
  #best-sellers .best-sellers-controls button { pointer-events:auto; display:grid; place-items:center; width:42px; height:42px; padding:0; border:1px solid rgba(255,255,255,.8); border-radius:50%; background:rgba(255,255,255,.92); color:#512536; font-size:21px; box-shadow:0 5px 18px rgba(44,24,22,.16); cursor:pointer; transition:transform .2s ease,background .2s ease; }
  #best-sellers .best-sellers-controls button:hover { transform:scale(1.08); background:#fff; }
  #best-sellers .best-sellers-controls button:focus-visible { outline:2px solid #7d2439; outline-offset:3px; }
  @media (min-width:750px) { #best-sellers .best-sellers-slide { flex-basis:calc(25% - 11px); } }
  @media (min-width:1100px) { #best-sellers .best-sellers-slide { flex-basis:calc(20% - 12px); } }
  @media (prefers-reduced-motion:reduce) { #best-sellers .best-sellers-track { scroll-behavior:auto; } }
</style>
<script>
  (() => {
    const carousel = document.querySelector('[data-best-sellers-carousel]');
    if (!carousel || carousel.dataset.carouselReady) return;
    carousel.dataset.carouselReady = 'true';
    const track = carousel.querySelector('[data-best-sellers-track]');
    const slides = Array.from(track.querySelectorAll('.best-sellers-slide'));
    if (slides.length < 2) return;
    let timer;
    let index = 0;
    const move = (step) => {
      index = (index + step + slides.length) % slides.length;
      track.scrollTo({ left: slides[index].offsetLeft - slides[0].offsetLeft, behavior: 'smooth' });
    };
    const stop = () => clearInterval(timer);
    const start = () => {
      stop();
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) timer = setInterval(() => move(1), 3000);
    };
    carousel.querySelector('[data-best-sellers-prev]')?.addEventListener('click', () => { move(-1); start(); });
    carousel.querySelector('[data-best-sellers-next]')?.addEventListener('click', () => { move(1); start(); });
    carousel.addEventListener('mouseenter', stop);
    carousel.addEventListener('mouseleave', start);
    carousel.addEventListener('focusin', stop);
    carousel.addEventListener('focusout', (event) => { if (!carousel.contains(event.relatedTarget)) start(); });
    start();
  })();
</script>

{% schema %}
{
  "name": "Best sellers",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Customer favourites" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Best sellers" },
    { "type": "collection", "id": "collection", "label": "Product source collection", "info": "Leave blank to check all products." },
    { "type": "text", "id": "tag", "label": "Product tag", "default": "best-seller" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 8, "step": 2, "default": 8, "label": "Products to show" },
    { "type": "checkbox", "id": "show_view_all", "label": "Show View all link", "default": true },
    { "type": "text", "id": "empty_heading", "label": "Empty state heading", "default": "Best sellers are coming soon" },
    { "type": "textarea", "id": "empty_text", "label": "Empty state text", "default": "Add the best-seller tag to products to feature them here." }
  ],
  "presets": [{ "name": "Best sellers" }]
}
{% endschema %}
