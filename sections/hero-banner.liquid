<section class="hero-section hero-carousel" aria-label="Featured campaigns" data-hero-carousel aria-roledescription="carousel">
  <div class="hero-carousel-slides">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.image != blank -%}
          <div class="hero-carousel-slide{% if forloop.first %} is-active{% endif %}" data-hero-slide{% unless forloop.first %} aria-hidden="true"{% endunless %} {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="hero-carousel-link">{%- endif -%}
            <picture class="hero-carousel-media{% if block.settings.mobile_image != blank %} has-mobile-image{% endif %}">
              {%- if block.settings.mobile_image != blank -%}
                <source
                  media="(max-width: 749px)"
                  srcset="{{ block.settings.mobile_image | image_url: width: 480 }} 480w, {{ block.settings.mobile_image | image_url: width: 750 }} 750w, {{ block.settings.mobile_image | image_url: width: 1100 }} 1100w"
                  sizes="100vw"
                >
              {%- endif -%}
              <img
                class="hero-carousel-image"
                src="{{ block.settings.image | image_url: width: 2400 }}"
                srcset="{{ block.settings.image | image_url: width: 800 }} 800w, {{ block.settings.image | image_url: width: 1200 }} 1200w, {{ block.settings.image | image_url: width: 1974 }} 1974w"
                sizes="100vw"
                alt="{{ block.settings.alt | escape }}"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
                {% if forloop.first %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}
              >
            </picture>
            {%- if block.settings.link != blank -%}</a>{%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  </div>

  {%- if section.blocks.size > 1 -%}
  <div class="hero-carousel-controls" aria-label="Carousel controls">
    <button class="hero-carousel-arrow" type="button" data-hero-prev aria-label="Previous banner">&#8592;</button>
    <div class="hero-carousel-dots" role="group" aria-label="Choose a banner">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.image != blank -%}
            <button class="hero-carousel-dot{% if forloop.first %} is-active{% endif %}" type="button" data-hero-dot="{{ forloop.index0 }}" aria-label="Show banner {{ forloop.index }}"{% if forloop.first %} aria-current="true"{% endif %}></button>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
    <button class="hero-carousel-arrow" type="button" data-hero-next aria-label="Next banner">&#8594;</button>
  </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Campaign carousel",
  "settings": [],
  "blocks": [
    {
      "type": "slide",
      "name": "Banner slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Banner image" },
        { "type": "image_picker", "id": "mobile_image", "label": "Mobile banner image (optional)" },
        { "type": "text", "id": "alt", "label": "Alt text", "default": "Zarnoor campaign" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "presets": [{ "name": "Campaign carousel", "blocks": [] }]
}
{% endschema %}
