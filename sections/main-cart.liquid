<div class="cart-page">
  <nav class="breadcrumbs" aria-label="Breadcrumb" style="margin-bottom:18px;">
    <a href="{{ routes.root_url }}">Home</a>
    <span aria-hidden="true">/</span>
    <span>Bag</span>
  </nav>

  <h1>Your bag</h1>

  {%- if cart.items.size == 0 -%}
    <div class="empty-state" style="padding-top:20px;">
      <h2>Your bag is empty</h2>
      <p>Add a piece to begin.</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn btn--outline">Shop all pieces</a>
    </div>
  {%- else -%}
    <form action="{{ routes.cart_url }}" method="post" novalidate class="cart-layout">
      <div class="cart-lines">
        {%- for item in cart.items -%}
          <div class="cart-line">
            <a href="{{ item.url }}">
              {%- if item.image -%}
                <img src="{{ item.image | image_url: width: 240 }}" alt="{{ item.product_title | escape }}" width="92" height="124" loading="lazy">
              {%- else -%}
                <span class="card-media card-media--fallback" style="width:92px;height:124px;display:flex;padding:8px;">
                  <span class="card-fallback-mark" style="font-size:10px;">{{ item.product_title | slice: 0, 14 }}</span>
                </span>
              {%- endif -%}
            </a>

            <div>
              <a href="{{ item.url }}"><h2 class="cart-line-title">{{ item.product_title }}</h2></a>
              {%- if item.variant.title != 'Default Title' -%}
                <p class="cart-line-meta">{{ item.variant.title }}</p>
              {%- endif -%}
              {%- if item.sku != blank -%}
                <p class="cart-line-meta">Code: {{ item.sku }}</p>
              {%- endif -%}
              <p class="cart-line-price">{{ item.final_line_price | money }}</p>
              <a href="{{ item.url_to_remove }}" class="cart-line-remove">Remove</a>
            </div>

            <div class="cart-line-controls">
              <label class="visually-hidden" for="updates_{{ forloop.index }}">Quantity</label>
              <input
                type="number"
                name="updates[]"
                id="updates_{{ forloop.index }}"
                value="{{ item.quantity }}"
                min="0"
                inputmode="numeric"
                class="qty-input"
              >
            </div>
          </div>
        {%- endfor -%}
      </div>

      <aside class="cart-summary">
        <h2>Order summary</h2>
        <div class="summary-row"><span>Subtotal</span><span>{{ cart.total_price | money }}</span></div>
        <div class="summary-row"><span>Delivery</span><span>Free</span></div>
        <div class="summary-row total"><span>Total</span><span>{{ cart.total_price | money }}</span></div>

        <button type="submit" name="checkout" class="btn btn-primary btn--block">Proceed to checkout</button>
        <button type="submit" name="update" class="cart-update">Update bag</button>

        <p class="cart-note">Cash on delivery available. Dispatched in 2–4 working days. 7-day exchange on unworn pieces.</p>
      </aside>
    </form>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Cart",
  "settings": []
}
{% endschema %}
