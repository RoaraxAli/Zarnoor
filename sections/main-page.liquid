{%- if page.handle == 'size-guide' or page.handle == 'size-chart' -%}
  <section class="page-shell size-chart-page">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span aria-hidden="true">/</span>
      <span>{{ page.title | default: 'Size guide' }}</span>
    </nav>

    <h1>{{ page.title | default: 'Size guide' }}</h1>

    {%- comment -%}
      The theme chart is canonical here, so any older chart image saved in the
      page body is intentionally not printed to avoid two charts side by side.
    {%- endcomment -%}
    {% render 'size-chart' %}
  </section>
{%- elsif page.handle == 'contact' -%}
  <section class="contact-page page-shell">
    <div class="contact-page__hero">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a>
        <span aria-hidden="true">/</span>
        <span>{{ page.title }}</span>
      </nav>

      <div class="contact-page__intro">
        <p class="contact-page__eyebrow">A note to the studio</p>
        <h1>{{ page.title | default: 'Get in touch' }}</h1>
        <p>Questions about a piece, your order, or finding the right fit? We’re here to help. Send us a message and our team will get back to you as soon as possible.</p>
      </div>
    </div>

    <div class="contact-page__layout">
      <div class="contact-page__details">
        <div class="contact-page__detail">
          <span class="contact-page__label">Email</span>
          {% if settings.contact_email != blank %}
            <a href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a>
          {% else %}
            <span>Send us a message using the form.</span>
          {% endif %}
        </div>
        <div class="contact-page__detail">
          <span class="contact-page__label">WhatsApp</span>
          <a href="https://wa.me/{{ settings.whatsapp_number | default: '923303957520' }}" target="_blank" rel="noopener">Chat with the studio <span aria-hidden="true">↗</span></a>
        </div>
        <p class="contact-page__note">For order questions, adding your order number helps us find things faster.</p>
      </div>

      <div class="contact-page__form-wrap">
        {% form 'contact', class: 'contact-form' %}
          {% if form.posted_successfully? %}
            <div class="contact-form__success" role="status" tabindex="-1">Thank you for reaching out. Your message is with our studio.</div>
          {% endif %}
          {% if form.errors %}
            <div class="contact-form__errors" role="alert">{{ form.errors | default_errors }}</div>
          {% endif %}
          <div class="contact-form__row">
            <div class="contact-form__field">
              <label for="ContactFormName">Your name</label>
              <input id="ContactFormName" type="text" name="contact[name]" autocomplete="name" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}" required>
            </div>
            <div class="contact-form__field">
              <label for="ContactFormEmail">Email address</label>
              <input id="ContactFormEmail" type="email" name="contact[email]" autocomplete="email" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}" autocorrect="off" autocapitalize="off" required>
            </div>
          </div>
          <div class="contact-form__row">
            <div class="contact-form__field">
              <label for="ContactFormPhone">Phone <span>(optional)</span></label>
              <input id="ContactFormPhone" type="tel" name="contact[phone]" autocomplete="tel" value="{{ form.phone }}">
            </div>
            <div class="contact-form__field">
              <label for="ContactFormOrder">Order number <span>(optional)</span></label>
              <input id="ContactFormOrder" type="text" name="contact[Order number]" autocomplete="off">
            </div>
          </div>
          <div class="contact-form__field">
            <label for="ContactFormMessage">How can we help?</label>
            <textarea id="ContactFormMessage" name="contact[body]" rows="6" required>{{ form.body }}</textarea>
          </div>
          <button class="contact-form__submit" type="submit">Send message <span aria-hidden="true">→</span></button>
        {% endform %}
      </div>
    </div>
  </section>
{%- else -%}
<div class="page-shell">
  <nav class="breadcrumbs" aria-label="Breadcrumb" style="margin-bottom:18px;">
    <a href="{{ routes.root_url }}">Home</a>
    <span aria-hidden="true">/</span>
    <span>{{ page.title }}</span>
  </nav>

  <h1>{{ page.title }}</h1>
  <div class="page-content">
    {{ page.content }}
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Page",
  "settings": []
}
{% endschema %}
