{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign fabric = product.metafields.custom.fabric.value | default: product.type -%}
{%- assign care = product.metafields.custom.care.value -%}
{%- assign fit = product.metafields.custom.fit.value -%}
{%- assign related = product.collections.first.products -%}
{%- assign wa_text = 'Hello Zarnoor, I would like to order ' | append: product.title | append: ' — ' | append: shop.url | append: product.url -%}

<div class="product-page">
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="{{ routes.root_url }}">Home</a>
    <span aria-hidden="true">/</span>
    {%- if product.collections.first -%}
      <a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a>
      <span aria-hidden="true">/</span>
    {%- endif -%}
    <span>{{ product.title }}</span>
  </nav>

  <div class="product-layout">
    <div class="product-gallery">
      <div class="gallery-thumbs">
        {%- for image in product.images limit: 6 -%}
          <button
            type="button"
            class="gallery-thumb{% if forloop.first %} is-active{% endif %}"
            data-gallery-thumb
            data-src="{{ image | image_url: width: 1400 }}"
            data-srcset="{{ image | image_url: width: 700 }} 700w, {{ image | image_url: width: 1000 }} 1000w, {{ image | image_url: width: 1400 }} 1400w"
            aria-label="View image {{ forloop.index }}"
          >
            <img src="{{ image | image_url: width: 180 }}" alt="" width="74" height="111" loading="lazy">
          </button>
        {%- endfor -%}
      </div>

      <div class="gallery-main">
        {%- if product.featured_image -%}
          <img
            id="gallery-main-image"
            src="{{ product.featured_image | image_url: width: 1200 }}"
            srcset="{{ product.featured_image | image_url: width: 700 }} 700w, {{ product.featured_image | image_url: width: 1000 }} 1000w, {{ product.featured_image | image_url: width: 1400 }} 1400w"
            sizes="(max-width: 899px) 100vw, 45vw"
            alt="{{ product.featured_image.alt | default: product.title | escape }}"
            width="{{ product.featured_image.width }}"
            height="{{ product.featured_image.height }}"
            fetchpriority="high"
          >
        {%- else -%}
          <span class="card-media--fallback" style="position:absolute;inset:0;display:flex;">
            <span class="card-fallback-mark">{{ fabric | default: 'Zarnoor' }}<span>Photography coming soon</span></span>
          </span>
        {%- endif -%}

        <button
          type="button"
          class="wishlist-btn"
          data-wishlist
          data-handle="{{ product.handle }}"
          data-title="{{ product.title | escape }}"
          data-url="{{ product.url }}"
          data-price="{{ product.price | money_without_currency | strip | replace: '.00', '' }}"
          data-image="{% if product.featured_image %}{{ product.featured_image | image_url: width: 300 }}{% endif %}"
          aria-label="Save {{ product.title | escape }}"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 20.5s-7.5-4.6-7.5-9.6a4.1 4.1 0 017.5-2.4 4.1 4.1 0 017.5 2.4c0 5-7.5 9.6-7.5 9.6z"/></svg>
        </button>
      </div>
    </div>

    <div class="product-info">
      <span class="eyebrow">{{ fabric | default: product.vendor | default: 'Zarnoor' }}</span>
      <h1 class="product-title-lg">{{ product.title }}</h1>
      {%- if current_variant.sku != blank -%}
        <span class="product-sku">Code: {{ current_variant.sku }}</span>
      {%- endif -%}

      <div class="product-price-row">
        <span class="price-current" id="product-price">{{ current_variant.price | money }}</span>
        <span class="price-original" id="product-compare" {% unless current_variant.compare_at_price > current_variant.price %}style="display:none;"{% endunless %}>
          {{ current_variant.compare_at_price | money }}
        </span>
      </div>

      {% form 'product', product, id: 'product-form', class: 'product-form' %}
        <input type="hidden" name="id" id="selected-variant-id" value="{{ current_variant.id }}">

        {%- for option in product.options_with_values -%}
          <div class="option-group" data-option-index="{{ forloop.index0 }}">
            <span class="option-label">
              <span>{{ option.name }}</span>
              {%- if option.name == 'Size' -%}
                <a href="#size-guide" class="size-guide-btn" data-open-size-guide>Size guide</a>
              {%- endif -%}
            </span>
            <div class="option-values">
              {%- for value in option.values -%}
                <button
                  type="button"
                  class="option-value{% if option.selected_value == value %} is-selected{% endif %}"
                  data-option-value="{{ value | escape }}"
                  data-option-position="{{ option.position }}"
                >
                  {{ value }}
                </button>
              {%- endfor -%}
            </div>
          </div>
        {%- endfor -%}

        <div class="qty-row">
          <div class="qty-stepper">
            <button type="button" data-qty-minus aria-label="Decrease quantity">−</button>
            <input type="number" name="quantity" id="product-qty" value="1" min="1" inputmode="numeric" aria-label="Quantity">
            <button type="button" data-qty-plus aria-label="Increase quantity">+</button>
          </div>
          <span class="stock-note" id="stock-note">{% if current_variant.available %}In stock{% else %}Sold out{% endif %}</span>
        </div>

        <div class="product-cta">
          <button type="submit" class="btn btn-primary btn--block" id="product-add-btn" {% unless current_variant.available %}disabled{% endunless %}>
            {% if current_variant.available %}Add to bag{% else %}Sold out{% endif %}
          </button>
          <a
            class="btn btn--outline btn--block"
            href="https://wa.me/{{ settings.whatsapp_number | default: '923303957520' }}?text={{ wa_text | url_encode }}"
            target="_blank"
            rel="noopener"
          >
            {{ section.settings.whatsapp_label | default: 'Order on WhatsApp' }}
          </a>
        </div>
      {% endform %}

      <ul class="usp-list">
        {%- if section.settings.usp_1 != blank -%}
          <li>
            <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            <span>{{ section.settings.usp_1 }}</span>
          </li>
        {%- endif -%}
        {%- if section.settings.usp_2 != blank -%}
          <li>
            <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            <span>{{ section.settings.usp_2 }}</span>
          </li>
        {%- endif -%}
        {%- if section.settings.usp_3 != blank -%}
          <li>
            <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            <span>{{ section.settings.usp_3 }}</span>
          </li>
        {%- endif -%}
      </ul>

      <div class="product-accordions">
        <details class="accordion" open>
          <summary>Details</summary>
          <div class="accordion-body">
            {%- if product.description != blank -%}
              {{ product.description }}
            {%- else -%}
              <p>{{ product.title }}{% if fabric != blank %} in {{ fabric | downcase }}{% endif %}. Cut and finished in our Karachi studio.</p>
            {%- endif -%}
            {%- if fit != blank -%}<p><strong>Fit:</strong> {{ fit }}</p>{%- endif -%}
          </div>
        </details>

        <details class="accordion">
          <summary>Fabric &amp; care</summary>
          <div class="accordion-body">
            {%- if fabric != blank -%}<p><strong>Fabric:</strong> {{ fabric }}</p>{%- endif -%}
            {%- if care != blank -%}
              {{ care }}
            {%- else -%}
              <p>Dry clean only. Steam lightly to remove creases. Store flat, away from direct sunlight.</p>
            {%- endif -%}
          </div>
        </details>

        <details class="accordion">
          <summary>Delivery &amp; returns</summary>
          <div class="accordion-body">
            {%- if section.settings.delivery_returns != blank -%}
              {{ section.settings.delivery_returns }}
            {%- else -%}
              <p>Free nationwide delivery with cash on delivery available. Orders are dispatched in 2–4 working days.</p>
              <p>Unworn pieces with tags attached can be exchanged within 7 days. Sale pieces are final sale.</p>
            {%- endif -%}
          </div>
        </details>

        <details class="accordion" id="size-guide">
          <summary>Size guide</summary>
          <div class="accordion-body">
            {%- if section.settings.size_guide != blank -%}
              {{ section.settings.size_guide }}
            {%- else -%}
              <table class="size-table">
                <thead>
                  <tr><th>Measurement</th><th>XS</th><th>S</th><th>M</th><th>L</th></tr>
                </thead>
                <tbody>
                  <tr><td>Length</td><td>56</td><td>56</td><td>57</td><td>57</td></tr>
                  <tr><td>Chest</td><td>19</td><td>20</td><td>22</td><td>24</td></tr>
                  <tr><td>Waist</td><td>18</td><td>19</td><td>21</td><td>23</td></tr>
                  <tr><td>Shoulder</td><td>14</td><td>14</td><td>15</td><td>16</td></tr>
                </tbody>
              </table>
              <p style="margin-top:10px;">Garment measurements in inches. Between sizes? Message the studio on WhatsApp.</p>
            {%- endif -%}
          </div>
        </details>
      </div>
    </div>
  </div>

  {%- if related.size > 1 -%}
    <section class="related-section">
      <div class="related-head">
        <h2>You may also like</h2>
        <a class="editorial-link" href="{{ product.collections.first.url | default: routes.all_products_collection_url }}">View collection</a>
      </div>
      <div class="products-grid">
        {%- assign shown = 0 -%}
        {%- for item in related -%}
          {%- if item.id != product.id and shown < 4 -%}
            {% render 'product-card', product: item, index: forloop.index %}
            {%- assign shown = shown | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </section>
  {%- endif -%}
</div>

<script type="application/json" id="product-variants-json">{{ product.variants | json }}</script>
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ shop.url | append: product.url | json }},
    {% if product.featured_image %}"image": ["https:{{ product.featured_image | image_url: width: 1200 }}"],{% endif %}
    "description": {{ product.description | strip_html | truncate: 300 | json }},
    {% if current_variant.sku != blank %}"sku": {{ current_variant.sku | json }},{% endif %}
    "brand": { "@type": "Brand", "name": {{ product.vendor | default: shop.name | json }} },
    "offers": {
      "@type": "Offer",
      "price": {{ current_variant.price | divided_by: 100.0 }},
      "priceCurrency": {{ cart.currency.iso_code | default: 'PKR' | json }},
      "availability": "https://schema.org/{% if current_variant.available %}InStock{% else %}OutOfStock{% endif %}",
      "url": {{ shop.url | append: product.url | json }}
    }
  }
</script>

{% schema %}
{
  "name": "Product",
  "settings": [
    { "type": "text", "id": "usp_1", "label": "USP 1", "default": "Free nationwide delivery · cash on delivery available" },
    { "type": "text", "id": "usp_2", "label": "USP 2", "default": "Dispatched in 2–4 working days" },
    { "type": "text", "id": "usp_3", "label": "USP 3", "default": "7-day exchange on unworn pieces with tags" },
    { "type": "text", "id": "whatsapp_label", "label": "WhatsApp button label", "default": "Order on WhatsApp" },
    { "type": "richtext", "id": "delivery_returns", "label": "Delivery & returns content" },
    { "type": "richtext", "id": "size_guide", "label": "Size guide content" }
  ]
}
{% endschema %}
