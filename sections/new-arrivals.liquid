{%- assign new_arrivals_collection = section.settings.collection | default: collections["all"] -%}
{%- assign new_arrivals_tag = section.settings.tag | default: "new-arrivals" | downcase | strip -%}
{%- assign new_arrivals_limit = section.settings.products_to_show | default: 8 -%}

<section id="new-arrivals" class="section-products new-arrivals-carousel" data-new-arrivals-carousel>
  <div class="section-header">
    <div class="section-header-title-block">
      {%- if section.settings.eyebrow != blank -%}
        <span class="section-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2 class="section-title">{{ section.settings.title | default: "New arrivals" }}</h2>
    </div>
    <div class="new-arrivals-actions">
      {%- if section.settings.show_view_all -%}
        <a class="editorial-link" href="{{ new_arrivals_collection.url | default: "/collections/all" }}">View all</a>
      {%- endif -%}
      {%- if new_arrivals_collection.products.size > 1 -%}
        <div class="new-arrivals-controls" aria-label="New arrivals carousel controls">
          <button type="button" data-new-arrivals-prev aria-label="Previous products">←</button>
          <button type="button" data-new-arrivals-next aria-label="Next products">→</button>
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- assign rendered_count = 0 -%}
  <div class="new-arrivals-track" data-new-arrivals-track aria-label="New arrival products">
    {%- paginate new_arrivals_collection.products by 250 -%}
      {%- for product in new_arrivals_collection.products -%}
        {%- assign product_tag_match = false -%}
        {%- for product_tag in product.tags -%}
          {%- assign normalized_product_tag = product_tag | downcase | strip -%}
          {%- if normalized_product_tag == new_arrivals_tag -%}
            {%- assign product_tag_match = true -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if product_tag_match -%}
          {%- assign product_card_index = rendered_count | plus: 1 -%}
          <div class="new-arrivals-slide">{% render "product-card", product: product, index: product_card_index %}</div>
          {%- assign rendered_count = rendered_count | plus: 1 -%}
          {%- if rendered_count >= new_arrivals_limit -%}{%- break -%}{%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endpaginate -%}
  </div>

  {%- if rendered_count == 0 -%}
    <div class="empty-state">
      <h2>{{ section.settings.empty_heading | default: "New arrivals are coming soon" }}</h2>
      <p>{{ section.settings.empty_text | default: "Add the new-arrivals tag to products to feature them here." }}</p>
    </div>
  {%- endif -%}
</section>

<style>
  #new-arrivals { position:relative; padding:clamp(36px,5vw,68px) clamp(18px,5vw,72px); background:#ffffff; border-top:1px solid #ece5dc; overflow:hidden; }
  #new-arrivals .section-header { max-width:var(--max); margin:0 auto 24px; align-items:flex-end; }
  #new-arrivals .new-arrivals-actions { display:flex; align-items:center; gap:22px; }
  #new-arrivals .new-arrivals-controls { display:flex; gap:8px; }
  #new-arrivals .new-arrivals-track { max-width:var(--max); margin:0 auto; display:flex; gap:18px; overflow-x:auto; scroll-snap-type:x mandatory; scrollbar-width:none; scroll-behavior:smooth; padding:2px 2px 12px; }
  #new-arrivals .new-arrivals-track::-webkit-scrollbar { display:none; }
  #new-arrivals .new-arrivals-slide { flex:0 0 calc(50% - 9px); min-width:0; scroll-snap-align:start; }
  #new-arrivals .product-card { width:100%; }
  #new-arrivals .card-media { aspect-ratio:4 / 5; border-radius:3px; background:#eee8e0; }
  #new-arrivals .product-meta { gap:5px; padding:12px 2px 0; }
  #new-arrivals .card-fabric { font-size:8px; letter-spacing:.16em; }
  #new-arrivals .card-title { font-size:13px; }
  #new-arrivals .card-price { margin-top:2px; }
  #new-arrivals .new-arrivals-controls button { display:grid; place-items:center; width:38px; height:38px; padding:0; border:1px solid #d8d0c7; border-radius:50%; background:transparent; color:#302724; font-size:18px; cursor:pointer; transition:background .2s ease,color .2s ease,border-color .2s ease; }
  #new-arrivals .new-arrivals-controls button:hover { background:#512536; color:#fff; border-color:#512536; }
  #new-arrivals .new-arrivals-controls button:focus-visible { outline:2px solid #7d2439; outline-offset:3px; }
  @media (min-width:750px) { #new-arrivals .new-arrivals-slide { flex-basis:calc(33.333% - 12px); } }
  @media (min-width:1000px) { #new-arrivals .new-arrivals-slide { flex-basis:calc(25% - 14px); } }
  @media (max-width:480px) { #new-arrivals .section-header { align-items:center; } #new-arrivals .new-arrivals-actions { gap:10px; } #new-arrivals .new-arrivals-controls button { width:34px; height:34px; } #new-arrivals .editorial-link { display:none; } }
  @media (prefers-reduced-motion:reduce) { #new-arrivals .new-arrivals-track { scroll-behavior:auto; } }
</style>
<script>
  (() => {
    const carousel = document.querySelector("[data-new-arrivals-carousel]");
    if (!carousel || carousel.dataset.carouselReady) return;
    carousel.dataset.carouselReady = "true";
    const track = carousel.querySelector("[data-new-arrivals-track]");
    const slides = Array.from(track.querySelectorAll(".new-arrivals-slide"));
    if (slides.length < 2) {
      const controls = carousel.querySelector(".new-arrivals-controls");
      if (controls) { controls.setAttribute("hidden", ""); }
      return;
    }
    let index = 0;
    const move = (step) => {
      index = (index + step + slides.length) % slides.length;
      track.scrollTo({ left: slides[index].offsetLeft - slides[0].offsetLeft, behavior: "smooth" });
    };
    const prevBtn = carousel.querySelector("[data-new-arrivals-prev]");
    const nextBtn = carousel.querySelector("[data-new-arrivals-next]");
    if (prevBtn) { prevBtn.addEventListener("click", () => move(-1)); }
    if (nextBtn) { nextBtn.addEventListener("click", () => move(1)); }
  })();
</script>

{% schema %}
{
  "name": "New arrivals",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Just landed" },
    { "type": "text", "id": "title", "label": "Heading", "default": "New arrivals" },
    { "type": "collection", "id": "collection", "label": "Product source collection", "info": "Leave blank to check all products." },
    { "type": "text", "id": "tag", "label": "Product tag", "default": "new-arrivals" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 8, "step": 2, "default": 8, "label": "Products to show" },
    { "type": "checkbox", "id": "show_view_all", "label": "Show View all link", "default": true },
    { "type": "text", "id": "empty_heading", "label": "Empty state heading", "default": "New arrivals are coming soon" },
    { "type": "textarea", "id": "empty_text", "label": "Empty state text", "default": "Add the new-arrivals tag to products to feature them here." }
  ],
  "presets": [{ "name": "New arrivals" }]
}
{% endschema %}
