<section id="shop-by-edit" class="shop-by-edit-section">
  <div class="shop-by-heading">
    <div>
      {%- if section.settings.eyebrow != blank -%}
        <span class="section-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2 class="section-title">{{ section.settings.title }}</h2>
    </div>
    {%- if section.settings.link_label != blank -%}
      <a class="editorial-link" href="{{ section.settings.link_url | default: routes.collections_url }}">{{ section.settings.link_label }}</a>
    {%- endif -%}
  </div>

  {%- assign has_real_blocks = false -%}
  {%- for block in section.blocks -%}
    {%- if block.settings.collection != blank or block.settings.image != blank -%}
      {%- assign has_real_blocks = true -%}
    {%- endif -%}
  {%- endfor -%}

  <div class="edit-cards">
    {%- if has_real_blocks -%}
      {%- comment -%} Cards added in the editor: order is whatever is dragged in the editor. {%- endcomment -%}
      {%- for block in section.blocks -%}
        <a class="edit-card" href="{{ block.settings.link | default: block.settings.collection.url | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="800" height="1200">
          {%- elsif block.settings.collection != blank -%}
            {%- assign c = block.settings.collection -%}
            {%- if c.image != blank -%}
              <img src="{{ c.image | image_url: width: 800 }}" alt="{{ c.title | escape }}" loading="lazy" width="800" height="1200">
            {%- elsif c.products.first.featured_image -%}
              <img src="{{ c.products.first.featured_image | image_url: width: 800 }}" alt="{{ c.title | escape }}" loading="lazy" width="800" height="1200">
            {%- endif -%}
          {%- endif -%}
          <span class="edit-card-title">{{ block.settings.title | default: block.settings.collection.title }}</span>
          {%- if block.settings.cta != blank -%}
            <span class="edit-card-cta">{{ block.settings.cta }} <b>→</b></span>
          {%- endif -%}
        </a>
      {%- endfor -%}
    {%- else -%}
      {%- comment -%}
        Auto-list. "Collections to show first" is pinned in the typed order, then the
        rest follow the chosen sort. Collections have no creation date in Liquid, so
        "newest" keys each one by the created_at of its newest product.
      {%- endcomment -%}
      {%- assign pinned = '' -%}
      {%- assign slot_1_handle = section.settings.slot_1.handle | default: '' -%}
      {%- assign slot_2_handle = section.settings.slot_2.handle | default: '' -%}
      {%- assign slot_3_handle = section.settings.slot_3.handle | default: '' -%}
      {%- assign slot_4_handle = section.settings.slot_4.handle | default: '' -%}
      {%- assign slot_5_handle = section.settings.slot_5.handle | default: '' -%}
      {%- assign slot_6_handle = section.settings.slot_6.handle | default: '' -%}
      {%- assign slot_list = '' | append: slot_1_handle | append: '~' | append: slot_2_handle | append: '~' | append: slot_3_handle | append: '~' | append: slot_4_handle | append: '~' | append: slot_5_handle | append: '~' | append: slot_6_handle | split: '~' -%}
      {%- for slot_handle in slot_list -%}
        {%- assign slot_handle = slot_handle | downcase -%}
        {%- if slot_handle == blank -%}{%- continue -%}{%- endif -%}
        {%- assign slot_needle = slot_handle | append: '~' -%}
        {%- if pinned contains slot_needle -%}{%- continue -%}{%- endif -%}
        {%- assign pinned = pinned | append: slot_needle -%}
      {%- endfor -%}
      {%- assign pin_list = section.settings.pin_handles | split: ',' -%}
      {%- for pin in pin_list -%}
        {%- assign pin_handle = pin | strip | downcase -%}
        {%- if pin_handle == blank -%}{%- continue -%}{%- endif -%}
        {%- assign pin_needle = pin_handle | append: '~' -%}
        {%- if pinned contains pin_needle -%}{%- continue -%}{%- endif -%}
        {%- assign pinned = pinned | append: pin_needle -%}
      {%- endfor -%}

      {%- capture sort_keys -%}
        {%- for collection in collections -%}
          {%- if collection.handle == 'frontpage' or collection.all_products_count == 0 -%}{%- continue -%}{%- endif -%}
          {%- assign collection_needle = collection.handle | append: '~' -%}
          {%- if pinned contains collection_needle -%}{%- continue -%}{%- endif -%}
          {%- case section.settings.sort_by -%}
            {%- when 'title_asc' or 'title_desc' -%}
              {%- assign sort_key = collection.title | downcase -%}
            {%- when 'most_products' -%}
              {%- assign sort_key = collection.all_products_count | prepend: '000000' | slice: -6, 6 -%}
            {%- else -%}
              {%- assign newest_product = collection.products | sort: 'created_at' | last -%}
              {%- assign sort_key = newest_product.created_at | date: '%s' -%}
          {%- endcase -%}
          {{- sort_key -}}|{{- collection.handle -}}~
        {%- endfor -%}
      {%- endcapture -%}

      {%- assign sort_keys = sort_keys | split: '~' -%}
      {%- case section.settings.sort_by -%}
        {%- when 'oldest' or 'title_asc' -%}
          {%- assign sort_keys = sort_keys | sort -%}
        {%- else -%}
          {%- assign sort_keys = sort_keys | sort | reverse -%}
      {%- endcase -%}

      {%- assign ordered = pinned -%}
      {%- for sort_key in sort_keys -%}
        {%- assign key_handle = sort_key | split: '|' | last -%}
        {%- if key_handle == blank -%}{%- continue -%}{%- endif -%}
        {%- assign ordered = ordered | append: key_handle | append: '~' -%}
      {%- endfor -%}

      {%- assign shown = 0 -%}
      {%- assign ordered_handles = ordered | split: '~' -%}
      {%- for handle in ordered_handles -%}
        {%- if handle == blank -%}{%- continue -%}{%- endif -%}
        {%- if shown >= section.settings.limit -%}{%- break -%}{%- endif -%}
        {%- assign card_collection = collections[handle] -%}
        {%- if card_collection == blank or card_collection.all_products_count == 0 -%}{%- continue -%}{%- endif -%}
        {%- assign shown = shown | plus: 1 -%}
        <a class="edit-card" href="{{ card_collection.url }}">
          {%- if card_collection.image != blank -%}
            <img src="{{ card_collection.image | image_url: width: 800 }}" alt="{{ card_collection.title | escape }}" loading="lazy" width="800" height="1200">
          {%- elsif card_collection.products.first.featured_image -%}
            <img src="{{ card_collection.products.first.featured_image | image_url: width: 800 }}" alt="{{ card_collection.title | escape }}" loading="lazy" width="800" height="1200">
          {%- endif -%}
          <span class="edit-card-title">{{ card_collection.title }}</span>
          <span class="edit-card-cta">Shop {{ card_collection.title | downcase }} <b>→</b></span>
        </a>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Shop by Collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop by Collection" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Find your kind of beautiful." },
    { "type": "text", "id": "link_label", "label": "Header link label", "default": "All collections" },
    { "type": "url", "id": "link_url", "label": "Header link URL" },
    { "type": "range", "id": "limit", "label": "Auto-list: collections to show", "min": 2, "max": 6, "step": 1, "default": 3 },
    { "type": "collection", "id": "slot_1", "label": "Position 1 collection", "info": "Pick a collection to force it into that position. Leave blank to use the sort order below. Position picks run before the pin list. Only used when no category cards are added." },
    { "type": "collection", "id": "slot_2", "label": "Position 2 collection" },
    { "type": "collection", "id": "slot_3", "label": "Position 3 collection" },
    { "type": "collection", "id": "slot_4", "label": "Position 4 collection" },
    { "type": "collection", "id": "slot_5", "label": "Position 5 collection" },
    { "type": "collection", "id": "slot_6", "label": "Position 6 collection" },
    {
      "type": "select",
      "id": "sort_by",
      "label": "Auto-list: sort order",
      "options": [
        { "value": "newest", "label": "Newest collection first" },
        { "value": "oldest", "label": "Oldest collection first" },
        { "value": "title_asc", "label": "Title A–Z" },
        { "value": "title_desc", "label": "Title Z–A" },
        { "value": "most_products", "label": "Most products first" }
      ],
      "default": "newest",
      "info": "Only used when no category cards are added below."
    },
    {
      "type": "text",
      "id": "pin_handles",
      "label": "Auto-list: collections to show first",
      "default": "winter-collection",
      "info": "Comma separated handles, in the order you want them. Example: winter-collection, royal-collection. Leave blank for no pinning."
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Category card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "collection", "id": "collection", "label": "Collection (auto-fills image/title/link)" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow / index" },
        { "type": "text", "id": "title", "label": "Title (blank = collection title)" },
        { "type": "text", "id": "cta", "label": "Button label" },
        { "type": "url", "id": "link", "label": "Link (blank = collection URL)" },
        { "type": "checkbox", "id": "accent", "label": "Use accent background (no image)", "default": false }
      ]
    }
  ],
  "presets": [
    { "name": "Shop by Collection", "blocks": [] }
  ]
}
{% endschema %}
