<section class="trust-badges-section" aria-label="Service information">
  {%- if section.settings.heading != blank -%}
    <div class="section-header" style="max-width: var(--max); margin: 0 auto 28px; padding: 0 var(--pad);">
      <div class="section-header-title-block">
        <span class="section-eyebrow">{{ section.settings.eyebrow }}</span>
        <h2 class="section-title">{{ section.settings.heading }}</h2>
      </div>
    </div>
  {%- endif -%}
  <div class="trust-badges-container">
    {%- for block in section.blocks -%}
      <div class="trust-badge-item" {{ block.shopify_attributes }}>
        <div class="trust-icon-box">
          {%- if block.settings.icon_image != blank -%}
            <img src="{{ block.settings.icon_image | image_url: width: 48 }}" alt="" width="24" height="24" loading="lazy">
          {%- else -%}
            {%- case block.settings.icon -%}
              {%- when 'truck' -%}<svg fill="none" stroke="currentColor" stroke-width="1.3" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 7h11v9H3zM14 10h4l3 3v3h-7zM6.5 19a1.5 1.5 0 100-3 1.5 1.5 0 000 3zM17.5 19a1.5 1.5 0 100-3 1.5 1.5 0 000 3z"/></svg>
              {%- when 'card' -%}<svg fill="none" stroke="currentColor" stroke-width="1.3" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16v10H4zM4 11h16M8 15h3"/></svg>
              {%- when 'return' -%}<svg fill="none" stroke="currentColor" stroke-width="1.3" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M20 12a8 8 0 11-2.3-5.6M20 4v4h-4"/></svg>
              {%- when 'chat' -%}<svg fill="none" stroke="currentColor" stroke-width="1.3" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 11.5a8.5 8.5 0 01-12.3 7.6L4 20l1-4.3A8.5 8.5 0 1121 11.5z"/></svg>
              {%- when 'shield' -%}<svg fill="none" stroke="currentColor" stroke-width="1.3" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6l7-3z"/></svg>
              {%- when 'box' -%}<svg fill="none" stroke="currentColor" stroke-width="1.3" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 7l9-4 9 4-9 4-9-4zM3 7v10l9 4 9-4V7M12 11v10"/></svg>
              {%- when 'clock' -%}<svg fill="none" stroke="currentColor" stroke-width="1.3" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 7v5l3 2M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              {%- else -%}<svg fill="none" stroke="currentColor" stroke-width="1.3" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            {%- endcase -%}
          {%- endif -%}
        </div>
        <div class="trust-badge-text">
          <h5>{{ block.settings.title }}</h5>
          <p>{{ block.settings.text }}</p>
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Service badges",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "truck", "options": [
          { "value": "truck", "label": "Truck (delivery)" },
          { "value": "card", "label": "Card (payment)" },
          { "value": "return", "label": "Return arrow" },
          { "value": "chat", "label": "Chat bubble" },
          { "value": "shield", "label": "Shield" },
          { "value": "box", "label": "Box" },
          { "value": "clock", "label": "Clock" },
          { "value": "check", "label": "Check" }
        ]},
        { "type": "image_picker", "id": "icon_image", "label": "Custom icon image (overrides icon)" },
        { "type": "text", "id": "title", "label": "Title", "default": "Free delivery" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Nationwide, on every order" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Service badges",
      "blocks": [
        { "type": "badge", "settings": { "icon": "truck", "title": "Free delivery", "text": "Nationwide, on every order" } },
        { "type": "badge", "settings": { "icon": "card", "title": "Cash on delivery", "text": "Pay when your parcel arrives" } },
        { "type": "badge", "settings": { "icon": "return", "title": "7-day exchange", "text": "Unworn pieces, tags attached" } },
        { "type": "badge", "settings": { "icon": "chat", "title": "Studio help", "text": "WhatsApp for sizing and orders" } }
      ]
    }
  ]
}
{% endschema %}