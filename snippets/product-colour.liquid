{%- comment -%}
  Product colour.
  Shows the piece's colour as a real swatch instead of a "Colour: …" text line.

  Label resolution order (first non-blank wins):
    1. the Shopify category metafield Color (shopify.color-pattern metaobject)
    2. a product option named Colour / Color
    3. product.metafields.custom.colour_name / custom.color_name
    4. the "Color: …" line at the top of the product description
    5. product.metafields.custom.colour / custom.color, when it is plain text
    6. a tag written as colour:Purple or color:Purple
    7. a colour word found in the title or tags

  Hex resolution order:
    1. the category metafield Color value (e.g. #F61F1F)
    2. product.metafields.custom.colour_hex / custom.color_hex
    3. product.metafields.custom.colour / custom.color when it holds a colour
    4. the built-in palette below
{%- endcomment -%}
{%- assign colour_label = '' -%}
{%- assign category_hex = '' -%}

{%- comment -%}
  Shopify's category metafield Color is a list of color-pattern metaobjects.
  Each entry carries a label ("Rich Crimson Red"), a colour (#F61F1F), an
  image and a base colour. Older/newer API versions disagree on how a list
  drop is walked (some ignore .first) and on where the fields sit (the entry
  itself, or the entry's .value), so walk the list with a for loop and try
  every shape.
{%- endcomment -%}
{%- assign colour_patterns = product.metafields.shopify['color-pattern'].value -%}
{%- if colour_patterns == blank -%}
  {%- assign colour_patterns = product.metafields.shopify['color-pattern'] -%}
{%- endif -%}
{%- assign colour_pattern = '' -%}

{%- for pattern_entry in colour_patterns -%}
  {%- assign pattern = pattern_entry.value | default: pattern_entry -%}
  {%- assign entry_label = pattern.label.value | default: pattern.label -%}
  {%- if entry_label == blank -%}{%- assign entry_label = pattern.display_name.value | default: pattern.display_name -%}{%- endif -%}
  {%- if entry_label == blank -%}{%- assign entry_label = pattern.name.value | default: pattern.name -%}{%- endif -%}
  {%- if entry_label == blank -%}{%- assign entry_label = pattern.system.title.value | default: pattern.system.title -%}{%- endif -%}
  {%- if entry_label == blank -%}{%- assign entry_label = pattern_entry.label.value | default: pattern_entry.label -%}{%- endif -%}
  {%- if entry_label == blank -%}{%- assign entry_label = pattern_entry.display_name.value | default: pattern_entry.display_name -%}{%- endif -%}
  {%- capture entry_label_txt -%}{{ entry_label }}{%- endcapture -%}
  {%- assign entry_label_txt = entry_label_txt | strip | remove: '[object Object]' | strip -%}
  {%- assign entry_label_head = entry_label_txt | slice: 0, 1 -%}
  {%- if entry_label_head == '#' or entry_label_txt contains '(' -%}
    {%- assign entry_label_txt = '' -%}
  {%- endif -%}

  {%- assign entry_hex = pattern.color.value | default: pattern.color -%}
  {%- if entry_hex == blank -%}{%- assign entry_hex = pattern_entry.color.value | default: pattern_entry.color -%}{%- endif -%}
  {%- capture entry_hex_txt -%}{{ entry_hex }}{%- endcapture -%}
  {%- assign entry_hex_txt = entry_hex_txt | strip -%}
  {%- assign entry_hex_head = entry_hex_txt | slice: 0, 1 -%}
  {%- unless entry_hex_txt == blank or entry_hex_txt contains '(' or entry_hex_head == '#' -%}
    {%- capture entry_hex_txt -%}{{ entry_hex | color_to_hex }}{%- endcapture -%}
    {%- assign entry_hex_txt = entry_hex_txt | strip -%}
  {%- endunless -%}

  {%- if entry_label_txt != blank or entry_hex_txt != blank -%}
    {%- if colour_pattern == '' -%}{%- assign colour_pattern = pattern_entry -%}{%- endif -%}
    {%- if entry_label_txt != blank -%}{%- assign colour_label = entry_label_txt -%}{%- endif -%}
    {%- if entry_hex_txt != blank -%}{%- assign category_hex = entry_hex_txt -%}{%- endif -%}
  {%- endif -%}
  {%- if colour_label != blank and category_hex != blank -%}{%- break -%}{%- endif -%}
{%- endfor -%}

{%- comment -%}
  A single reference or a bare string iterates as nothing, so fall back to the
  value itself: the handle (rich-crimson-red) still gives a usable name.
{%- endcomment -%}
{%- if colour_pattern == '' and colour_patterns != blank -%}
  {%- assign colour_pattern = colour_patterns -%}
{%- endif -%}
{%- if colour_label == blank and colour_patterns != blank -%}
  {%- assign pattern_handle = colour_pattern.system.handle.value | default: colour_pattern.system.handle -%}
  {%- if pattern_handle == blank -%}{%- assign pattern_handle = colour_pattern.handle.value | default: colour_pattern.handle -%}{%- endif -%}
  {%- capture pattern_handle_txt -%}{{ pattern_handle }}{%- endcapture -%}
  {%- assign pattern_handle_txt = pattern_handle_txt | strip | remove: '[object Object]' | strip | replace: '_', '-' -%}
  {%- if pattern_handle_txt == blank -%}
    {%- capture pattern_handle_txt -%}{{ colour_patterns }}{%- endcapture -%}
    {%- assign pattern_handle_txt = pattern_handle_txt | strip -%}
    {%- assign pattern_handle_txt = pattern_handle_txt | remove: 'MetaobjectDrop' | remove: 'Metaobjectlistdrop' | remove: '[object Object]' | remove: '[]' | strip -%}
  {%- endif -%}
  {%- assign pattern_handle_head = pattern_handle_txt | slice: 0, 1 -%}
  {%- if pattern_handle_txt contains '-' -%}
    {%- assign handle_words = pattern_handle_txt | split: '-' -%}
    {%- capture pattern_handle_txt -%}
      {%- for word in handle_words -%}{{ word | strip | capitalize }}{%- unless forloop.last %} {% endunless -%}{%- endfor -%}
    {%- endcapture -%}
    {%- assign pattern_handle_txt = pattern_handle_txt | strip -%}
  {%- endif -%}
  {%- if pattern_handle_txt != blank and pattern_handle_head != '#' and pattern_handle_txt != '#F61F1F' -%}
    {%- assign colour_label = pattern_handle_txt -%}
  {%- endif -%}
{%- endif -%}

{%- comment -%} Leave a clue in the page source if the field is present but unreadable. {%- endcomment -%}
{%- if colour_patterns != blank and colour_label == blank -%}
  <!-- zarnoor-colour patterns=[{{ colour_patterns }}] entry=[{{ colour_pattern }}] label=[{{ colour_label }}] hex=[{{ category_hex }}] -->
{%- endif -%}

{%- for option in product.options_with_values -%}
  {%- assign option_name = option.name | downcase -%}
  {%- if option_name contains 'color' or option_name contains 'colou' -%}
    {%- assign option_colour = option.selected_value | default: option.values.first | default: '' | strip -%}
    {%- assign option_colour_down = option_colour | downcase -%}
    {%- if option_colour_down != '' and option_colour_down != 'default title' -%}
      {%- if colour_label == blank -%}{%- assign colour_label = option_colour -%}{%- endif -%}
      {%- break -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}

{%- if colour_label == blank -%}
  {%- assign colour_label = product.metafields.custom.colour_name.value | default: product.metafields.custom.color_name.value | default: '' -%}
{%- endif -%}

{%- comment -%}
  The name typed on the product itself — the "Color: Rich Crimson Pink" line
  that the import put at the top of the description — beats any tag or guess.
{%- endcomment -%}
{%- if colour_label == blank and product.description contains 'olor' -%}
  {%- assign desc_chunks = product.description | split: '</p>' -%}
  {%- for chunk in desc_chunks -%}
    {%- assign probe = chunk | strip_html | strip -%}
    {%- assign probe_down = probe | downcase -%}
    {%- assign probe_head6 = probe_down | slice: 0, 6 -%}
    {%- assign probe_head7 = probe_down | slice: 0, 7 -%}
    {%- if probe_head6 == 'color:' or probe_head7 == 'colour:' -%}
      {%- assign colour_label = probe | split: ':' | last | strip -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{%- assign colour_meta = product.metafields.custom.colour.value | default: product.metafields.custom.color.value -%}
{%- capture colour_meta_raw -%}{{ colour_meta }}{%- endcapture -%}
{%- assign colour_meta_raw = colour_meta_raw | strip -%}
{%- assign colour_meta_head = colour_meta_raw | slice: 0, 1 -%}

{%- comment -%} A colour-type metafield prints as #hex or rgb(…), not a name. {%- endcomment -%}
{%- if colour_meta_raw contains '(' or colour_meta_head == '#' -%}
  {%- assign colour_meta_css = colour_meta_raw -%}
{%- elsif colour_meta_raw != blank and colour_label == blank -%}
  {%- assign colour_label = colour_meta_raw -%}
{%- endif -%}

{%- if colour_label == blank -%}
  {%- for tag in product.tags -%}
    {%- assign tag_down = tag | downcase | strip -%}
    {%- if tag_down contains 'colour:' or tag_down contains 'color:' -%}
      {%- assign colour_label = tag | split: ':' | last | strip -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{%- capture colour_haystack -%}{{ product.title }} {{ colour_label }}{%- for tag in product.tags %} {{ tag }}{%- endfor -%}{%- endcapture -%}
{%- assign colour_haystack = colour_haystack | downcase -%}

{%- if colour_label == blank -%}
  {%- assign palette_words = 'dusty rose,deep rose,powder blue,petal pink,poison blue,cocoa brown,allure black,golden,champagne,jet black,black,purple,maroon,burgundy,oxblood,crimson,wine,plum,red,rose,mauve,pink,peach,coco,cocoa,mocha,brown,taupe,biscotti,beige,cream,ivory,blue,matcha,sage,green,olive,mint,teal,navy,lavender,lilac,mustard,rust,terracotta,silver,grey,gray,white' | split: ',' -%}
  {%- for word in palette_words -%}
    {%- if colour_haystack contains word -%}
      {%- assign colour_label = word | capitalize -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{%- if colour_label != blank -%}
  {%- assign label_words = colour_label | split: ' ' -%}
  {%- capture colour_label -%}
    {%- for word in label_words -%}{{ word | capitalize }}{%- unless forloop.last %} {% endunless -%}{%- endfor -%}
  {%- endcapture -%}
{%- endif -%}

{%- assign colour_hex = category_hex | default: '' -%}
{%- if colour_hex == blank -%}
  {%- assign colour_hex = product.metafields.custom.colour_hex.value | default: product.metafields.custom.color_hex.value | default: '' -%}
{%- endif -%}

{%- if colour_hex == blank and colour_meta_css != blank -%}
  {%- assign colour_hex = colour_meta_css -%}
{%- endif -%}

{%- if colour_hex == blank -%}
  {%- assign colour_key = colour_haystack | append: ' ' | append: colour_label | downcase -%}
  {%- assign colour_hex = '#cfc6bb' -%}
  {%- if colour_key contains 'allure' or colour_key contains 'black' -%}{%- assign colour_hex = '#121212' -%}
  {%- elsif colour_key contains 'aks' or colour_key contains 'purple' -%}{%- assign colour_hex = '#6c3f8f' -%}
  {%- elsif colour_key contains 'imaan' or colour_key contains 'red' -%}{%- assign colour_hex = '#a51f2b' -%}
  {%- elsif colour_key contains 'mehfil' or colour_key contains 'gold' or colour_key contains 'champagne' -%}{%- assign colour_hex = '#b78a3c' -%}
  {%- elsif colour_key contains 'pastelle' or colour_key contains 'peach' -%}{%- assign colour_hex = '#efb39a' -%}
  {%- elsif colour_key contains 'coco' or colour_key contains 'cocoa' or colour_key contains 'brown' -%}{%- assign colour_hex = '#5f4032' -%}
  {%- elsif colour_key contains 'biscotti' or colour_key contains 'beige' or colour_key contains 'camel' -%}{%- assign colour_hex = '#cdb08a' -%}
  {%- elsif colour_key contains 'deep rose' or colour_key contains 'maroon' or colour_key contains 'burgundy' -%}{%- assign colour_hex = '#9d2438' -%}
  {%- elsif colour_key contains 'dusty rose' or colour_key contains 'rose' -%}{%- assign colour_hex = '#c08b8f' -%}
  {%- elsif colour_key contains 'petal' or colour_key contains 'pink' -%}{%- assign colour_hex = '#f0bfc9' -%}
  {%- elsif colour_key contains 'poison' or colour_key contains 'navy' -%}{%- assign colour_hex = '#1e2f52' -%}
  {%- elsif colour_key contains 'powder' or colour_key contains 'sky' -%}{%- assign colour_hex = '#a8c6dd' -%}
  {%- elsif colour_key contains 'matcha' or colour_key contains 'olive' -%}{%- assign colour_hex = '#7d8f5a' -%}
  {%- elsif colour_key contains 'mint' or colour_key contains 'green' -%}{%- assign colour_hex = '#7fa88a' -%}
  {%- elsif colour_key contains 'teal' -%}{%- assign colour_hex = '#2f6f73' -%}
  {%- elsif colour_key contains 'lilac' -%}{%- assign colour_hex = '#b3a0cf' -%}
  {%- elsif colour_key contains 'mustard' -%}{%- assign colour_hex = '#c2982f' -%}
  {%- elsif colour_key contains 'silver' or colour_key contains 'grey' or colour_key contains 'gray' -%}{%- assign colour_hex = '#b8b8b8' -%}
  {%- elsif colour_key contains 'ivory' or colour_key contains 'cream' or colour_key contains 'white' -%}{%- assign colour_hex = '#f2ece1' -%}
  {%- elsif colour_key contains 'oxblood' or colour_key contains 'crimson' -%}{%- assign colour_hex = '#7d1f2b' -%}
  {%- elsif colour_key contains 'wine' or colour_key contains 'plum' -%}{%- assign colour_hex = '#5a2a4a' -%}
  {%- elsif colour_key contains 'mauve' -%}{%- assign colour_hex = '#9b7b86' -%}
  {%- elsif colour_key contains 'mocha' -%}{%- assign colour_hex = '#6f5140' -%}
  {%- elsif colour_key contains 'taupe' -%}{%- assign colour_hex = '#a2917f' -%}
  {%- elsif colour_key contains 'sage' -%}{%- assign colour_hex = '#9caf88' -%}
  {%- elsif colour_key contains 'rust' or colour_key contains 'terracotta' -%}{%- assign colour_hex = '#b4552d' -%}
  {%- elsif colour_key contains 'lavender' -%}{%- assign colour_hex = '#b3a0cf' -%}
  {%- elsif colour_key contains 'blue' -%}{%- assign colour_hex = '#3d5f8a' -%}
  {%- endif -%}
{%- endif -%}

{%- if colour_label != blank or colour_meta_css != blank or category_hex != blank -%}
  <div class="product-colour">
    <span class="product-colour-label">Color</span>
    <span class="product-colour-chip" style="background-color: {{ colour_hex }};"></span>
    {%- if colour_label != blank -%}<span class="product-colour-name">{{ colour_label }}</span>{%- endif -%}
  </div>

  <style>
    .product-colour {
      display: flex;
      align-items: center;
      gap: 8px;
      margin: 12px 0 2px;
      font-size: 11px;
      letter-spacing: .04em;
      color: var(--ink, #302724);
    }
    .product-colour-label {
      font-size: 9px;
      letter-spacing: .16em;
      text-transform: uppercase;
      color: var(--muted, #8a7d74);
    }
    .product-colour-chip {
      width: 15px;
      height: 15px;
      border-radius: 50%;
      border: 1px solid rgba(0, 0, 0, .16);
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .45);
      flex: 0 0 auto;
    }
    .product-colour-name { color: var(--ink, #302724); }
  </style>
{%- endif -%}
