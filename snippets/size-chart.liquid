{%- comment -%}
  Zarnoor size chart — one chart by default, overridable per product.

  Per-product override (Shopify admin):
    Product → Metafields → Custom data → "Size chart" → upload an image.
    namespace: custom   key: size_chart
    Also accepted: custom.size_chart_image, custom.size_guide,
                   custom.size_chart_url (a plain URL).

  Usage:
    {% render 'size-chart', product: product %}
    {% render 'size-chart' %}                          → default theme chart
    {% render 'size-chart', product: product, fallback_html: section.settings.size_guide %}

  Priority: product metafield image → fallback_html → default theme chart.
{%- endcomment -%}

{%- liquid
  assign chart_url = ''
  assign chart_srcset = ''
  assign chart_alt_custom = ''
  assign chart_width = 0
  assign chart_height = 0
  assign chart_is_file = false

  if product != blank
    assign chart_mf = product.metafields.custom.size_chart
    if chart_mf == blank
      assign chart_mf = product.metafields.custom.size_chart_image
    endif
    if chart_mf == blank
      assign chart_mf = product.metafields.custom.size_guide
    endif

    if chart_mf != blank
      if chart_mf.type contains 'file'
        assign chart_is_file = true
        assign chart_file = chart_mf.value
        if chart_file.preview_image != blank
          assign chart_image = chart_file.preview_image
          assign chart_url = chart_image | image_url: width: 1400
          assign chart_srcset = chart_image | image_url: width: 700
          assign chart_srcset = chart_srcset | append: ' 700w, ' | append: chart_url | append: ' 1400w'
          assign chart_width = chart_image.width
          assign chart_height = chart_image.height
          assign chart_alt_custom = chart_image.alt
        elsif chart_file.url != blank
          assign chart_url = chart_file.url
          assign chart_alt_custom = chart_file.alt
        endif
      elsif chart_mf.type contains 'url'
        assign chart_raw = chart_mf.value
        assign chart_url = chart_raw
        if chart_raw.link != blank
          assign chart_url = chart_raw.link
        endif
      elsif chart_mf.type contains 'single_line_text' or chart_mf.type contains 'multi_line_text'
        assign chart_raw = chart_mf.value
        if chart_raw contains 'http'
          assign chart_url = chart_raw
        endif
      endif
    endif

    if chart_url == blank
      assign chart_mf = product.metafields.custom.size_chart_url
      if chart_mf != blank
        assign chart_raw = chart_mf.value
        assign chart_url = chart_raw
        if chart_raw.link != blank
          assign chart_url = chart_raw.link
        endif
        if chart_mf.type contains 'text'
          unless chart_raw contains 'http'
            assign chart_url = ''
          endunless
        endif
      endif
    endif
  endif

  assign chart_is_default = false
  if chart_url == blank
    assign chart_is_default = true
    assign chart_url = 'zarnoor-size-chart.jpg' | asset_url
    assign chart_width = 1536
    assign chart_height = 1024
  endif

  assign chart_is_pdf = false
  if chart_is_file and chart_srcset == blank
    assign chart_is_pdf = true
  elsif chart_url contains '.pdf'
    assign chart_is_pdf = true
  endif

  assign chart_alt = chart_alt_custom
  if chart_alt == blank
    if chart_is_default
      assign chart_alt = 'Zarnoor size chart — shirt and trouser measurements in inches for Small, Medium, Large and Extra Large'
    elsif product != blank
      assign chart_alt = 'Size chart for ' | append: product.title
    else
      assign chart_alt = 'Size chart with garment measurements'
    endif
  endif
-%}

{%- if chart_is_default and fallback_html != blank -%}
  <div class="size-chart">
    <div class="size-chart-body">{{ fallback_html }}</div>
    <p class="size-chart-note">Garment measurements in inches. Between sizes? Message the studio on WhatsApp.</p>
  </div>
{%- elsif chart_is_pdf -%}
  <div class="size-chart">
    <a class="size-chart-file" href="{{ chart_url }}" target="_blank" rel="noopener">
      {{ chart_alt | default: 'Open size chart' }} (PDF) <span aria-hidden="true">↗</span>
    </a>
    <p class="size-chart-note">Garment measurements in inches. Between sizes? Message the studio on WhatsApp.</p>
  </div>
{%- else -%}
  <div class="size-chart">
    <div class="size-chart-scroll">
      <img
        src="{{ chart_url }}"
        {%- if chart_srcset != blank %} srcset="{{ chart_srcset }}" sizes="(max-width: 749px) 100vw, 720px"{% endif %}
        alt="{{ chart_alt | escape }}"
        {%- if chart_width > 0 and chart_height > 0 %} width="{{ chart_width }}" height="{{ chart_height }}"{% endif %}
        loading="lazy">
    </div>
    <p class="size-chart-note">Garment measurements in inches. Between sizes? Message the studio on WhatsApp.</p>
  </div>
{%- endif -%}

<style>
  .size-chart { margin: 4px 0 6px; }
  .size-chart-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border: 1px solid var(--line, #ece5dc);
    background: #fff;
  }
  .size-chart-scroll img {
    display: block;
    width: 100%;
    min-width: 560px;
    height: auto;
  }
  .size-chart-body { font-size: 13px; line-height: 1.8; }
  .size-chart-file {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 12px 16px;
    border: 1px solid var(--line, #ece5dc);
    background: #fff;
    font-size: 13px;
    color: var(--ink, #2d1f1f);
    text-decoration: none;
  }
  .size-chart-file:hover { border-color: var(--ink, #2d1f1f); }
  .size-chart-body img { max-width: 100%; height: auto; }
  .size-chart-note {
    margin-top: 10px;
    font-size: 11px;
    line-height: 1.7;
    color: var(--muted, #8a7d74);
  }
  .size-chart-page .size-chart-scroll img { min-width: 720px; }
</style>
