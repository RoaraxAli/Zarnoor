{%- comment -%}
  Linked brand mark. The image itself lives in snippets/logo-image.liquid so the
  header, footer, drawer, preloader and 404 page can never drift apart.
{%- endcomment -%}
<a href="{{ routes.root_url }}" class="brand-logo-link" aria-label="{{ shop.name | escape }}">
  {%- render 'logo-image', logo: settings.logo, alt: shop.name, class: 'brand-logo-img', sizes: sizes -%}
</a>
