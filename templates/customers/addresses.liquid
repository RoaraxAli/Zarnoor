<div class="page-shell" style="max-width:620px;">
  <h1>Addresses</h1>

  {% paginate customer.addresses by 6 %}
    {% for address in customer.addresses %}
      <div style="padding:18px 0;border-bottom:1px solid var(--line);">
        {% if address == customer.default_address %}<span class="section-eyebrow">Default</span>{% endif %}
        <p style="font-size:12px;line-height:1.8;color:var(--muted);margin-top:6px;">{{ address | format_address }}</p>
        <form method="post" action="{{ address.url }}" style="margin-top:10px;">
          <input type="hidden" name="_method" value="delete">
          <button type="submit" class="cart-line-remove">Delete</button>
        </form>
      </div>
    {% endfor %}
  {% endpaginate %}

  <h2 style="font-family:var(--serif);font-size:24px;text-transform:uppercase;margin:32px 0 14px;">Add address</h2>
  {% form 'customer_address', customer.new_address %}
    <div class="form-field"><label for="address_first_name">First name</label><input type="text" name="address[first_name]" id="address_first_name"></div>
    <div class="form-field"><label for="address_last_name">Last name</label><input type="text" name="address[last_name]" id="address_last_name"></div>
    <div class="form-field"><label for="address_address1">Address</label><input type="text" name="address[address1]" id="address_address1"></div>
    <div class="form-field"><label for="address_city">City</label><input type="text" name="address[city]" id="address_city"></div>
    <div class="form-field"><label for="address_province">Province</label><input type="text" name="address[province]" id="address_province"></div>
    <div class="form-field"><label for="address_zip">Postal code</label><input type="text" name="address[zip]" id="address_zip"></div>
    <div class="form-field"><label for="address_phone">Phone</label><input type="tel" name="address[phone]" id="address_phone"></div>
    <button type="submit" class="btn btn-primary btn--block">Save address</button>
  {% endform %}
</div>
