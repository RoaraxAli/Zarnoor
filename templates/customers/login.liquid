<div class="page-shell" style="max-width:520px;">
  <h1>Sign in</h1>

  {% form 'customer_login' %}
    {% if form.errors %}<div class="form-error">{{ form.errors | default_errors }}</div>{% endif %}

    <div class="form-field">
      <label for="customer_email">Email</label>
      <input type="email" name="customer[email]" id="customer_email" autocomplete="email" required>
    </div>
    <div class="form-field">
      <label for="customer_password">Password</label>
      <input type="password" name="customer[password]" id="customer_password" autocomplete="current-password" required>
    </div>

    <button type="submit" class="btn btn-primary btn--block">Sign in</button>

    <div class="form-links">
      <a href="{{ routes.account_register_url }}">Create an account</a>
      <a href="#recover">Forgot password</a>
    </div>
  {% endform %}

  <div id="recover" style="margin-top:36px;">
    <h2 style="font-family:var(--serif);font-size:24px;text-transform:uppercase;margin-bottom:14px;">Reset password</h2>
    {% form 'recover_customer_password' %}
      {% if form.posted_successfully? %}
        <p class="newsletter-desc">Check your email for a reset link.</p>
      {% endif %}
      <div class="form-field">
        <label for="recover_email">Email</label>
        <input type="email" name="email" id="recover_email" autocomplete="email" required>
      </div>
      <button type="submit" class="btn btn--outline btn--block">Send reset link</button>
    {% endform %}
  </div>
</div>
