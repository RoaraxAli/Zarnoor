<div class="page-shell" style="max-width:520px;">
  <h1>Create account</h1>

  {% form 'create_customer' %}
    {% if form.errors %}<div class="form-error">{{ form.errors | default_errors }}</div>{% endif %}

    <div class="form-field">
      <label for="first_name">First name</label>
      <input type="text" name="customer[first_name]" id="first_name" autocomplete="given-name">
    </div>
    <div class="form-field">
      <label for="last_name">Last name</label>
      <input type="text" name="customer[last_name]" id="last_name" autocomplete="family-name">
    </div>
    <div class="form-field">
      <label for="register_email">Email</label>
      <input type="email" name="customer[email]" id="register_email" autocomplete="email" required>
    </div>
    <div class="form-field">
      <label for="register_password">Password</label>
      <input type="password" name="customer[password]" id="register_password" autocomplete="new-password" required>
    </div>

    <button type="submit" class="btn btn-primary btn--block">Create account</button>

    <div class="form-links">
      <a href="{{ routes.account_login_url }}">Already have an account? Sign in</a>
    </div>
  {% endform %}
</div>
