<div class="page-shell" style="max-width:520px;">
  <h1>Reset password</h1>
  {% form 'reset_customer_password' %}
    {% if form.errors %}<div class="form-error">{{ form.errors | default_errors }}</div>{% endif %}
    <div class="form-field"><label for="reset_password">New password</label><input type="password" name="customer[password]" id="reset_password" autocomplete="new-password" required></div>
    <div class="form-field"><label for="reset_password_confirmation">Confirm password</label><input type="password" name="customer[password_confirmation]" id="reset_password_confirmation" autocomplete="new-password" required></div>
    <button type="submit" class="btn btn-primary btn--block">Reset password</button>
  {% endform %}
</div>
